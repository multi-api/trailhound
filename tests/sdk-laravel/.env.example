APP_NAME="Trailhound Scout compatibility"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true

DB_CONNECTION=sqlite
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

# Everything Scout needs to use Trailhound: the Meilisearch driver, the
# server's address and a tenant key.
SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=laravel_
MEILISEARCH_HOST=http://127.0.0.1:7711
MEILISEARCH_KEY=test-master-key
