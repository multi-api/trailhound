{
    "name": "trailhound/sdk-laravel-compat",
    "description": "A minimal Laravel application that drives a running Trailhound server through Laravel Scout's Meilisearch driver.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "13.44.1",
        "laravel/scout": "11.11.0",
        "meilisearch/meilisearch-php": "1.17.0",
        "http-interop/http-factory-guzzle": "1.2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "test": "@php compat.php"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
